<UserControl x:Class="Catogarizer.App.Controls.AppIconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False">
    <Grid x:Name="Root" Width="24" Height="24">
        <Border x:Name="Tile" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <TextBlock x:Name="Letters" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource UiFont}"/>
        </Border>
        <Image x:Name="Icon" Opacity="0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</UserControl>
