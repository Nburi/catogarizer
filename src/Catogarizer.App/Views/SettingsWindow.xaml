<Window x:Class="Catogarizer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="22">
        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,18"/>

        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                   Foreground="{StaticResource InkBrush}" FontSize="13.5" Margin="0,0,0,12"/>
        <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}"
                   Foreground="{StaticResource InkBrush}" FontSize="13.5" Margin="0,0,0,18"/>

        <TextBlock Text="Command palette shortcut" Style="{StaticResource FieldLabelStyle}"/>
        <Border x:Name="HotkeyCaptureBox" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="10,8" Focusable="True"
                PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown"
                GotFocus="HotkeyCaptureBox_GotFocus" LostFocus="HotkeyCaptureBox_LostFocus">
            <TextBlock x:Name="HotkeyDisplayText" Text="{Binding HotkeyText}" Foreground="{StaticResource InkBrush}" FontSize="13.5"/>
        </Border>
        <TextBlock Text="Click the box above, then press the key combination you want."
                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,5,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Automation..." Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenTriggersCommand}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="90"
                    Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
