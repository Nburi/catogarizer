<Window x:Class="Catogarizer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- A theme tile: a mini preview of the theme's own surfaces, so you pick by look, not by name. -->
        <Style x:Key="ThemeTileStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="32" CornerRadius="6" Background="{Binding Background}"
                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Margin="0,0,10,0">
                                    <Grid Margin="5">
                                        <Border Background="{Binding Surface}" CornerRadius="3" Width="18" HorizontalAlignment="Left"/>
                                        <Border Background="{Binding Accent}" CornerRadius="3" Width="10" Height="10"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        <Border Background="{Binding Ink}" CornerRadius="1" Width="10" Height="2"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Frame" Property="Padding" Value="7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,18"/>

        <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
        <TextBlock Text="Changes apply right away. Cancel takes you back to the one you had."
                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,0,0,8"/>
        <ItemsControl ItemsSource="{Binding Themes}" Margin="0,0,-8,10" KeyboardNavigation.DirectionalNavigation="Cycle">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource ThemeTileStyle}" GroupName="Theme"
                                 AutomationProperties.Name="{Binding Name}"
                                 Checked="ThemeTile_Checked" Loaded="ThemeTile_Loaded"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                   Foreground="{DynamicResource InkBrush}" FontSize="13.5" Margin="0,0,0,12"/>
        <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}"
                   Foreground="{DynamicResource InkBrush}" FontSize="13.5" Margin="0,0,0,18"/>

        <TextBlock Text="Command palette shortcut" Style="{StaticResource FieldLabelStyle}"/>
        <Border x:Name="HotkeyCaptureBox" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="10,8" Focusable="True"
                PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown"
                GotFocus="HotkeyCaptureBox_GotFocus" LostFocus="HotkeyCaptureBox_LostFocus">
            <TextBlock x:Name="HotkeyDisplayText" Text="{Binding HotkeyText}" Foreground="{DynamicResource InkBrush}" FontSize="13.5"/>
        </Border>
        <TextBlock Text="Click the box above, then press the key combination you want."
                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,5,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Automation..." Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenTriggersCommand}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="90"
                    Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
