<Window x:Class="Catogarizer.App.Views.PlacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="22">
        <TextBlock Text="Set window position" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Open app" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding OpenAppCommand}"/>
            <Button Content="Capture position" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CapturePositionCommand}"/>
        </StackPanel>

        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="12"
                Visibility="{Binding CapturedSummary, Converter={StaticResource NullToCollapsedConverter}}"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Captured placement" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="{Binding CapturedSummary}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Cursor="Hand" Foreground="{StaticResource AccentBrush}" FontSize="12.5" Margin="0,0,0,10"
                   Visibility="{Binding CapturedSummary, Converter={StaticResource NullToCollapsedConverter}}">
            <Hyperlink Command="{Binding ClearPlacementCommand}" TextDecorations="None">
                Clear captured placement
            </Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0"
                    Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="90"
                    Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
