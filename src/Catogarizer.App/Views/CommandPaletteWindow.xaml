<Window x:Class="Catogarizer.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="14" Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="10">
            <TextBox x:Name="SearchBox" Style="{StaticResource ThemedTextBoxStyle}" FontSize="15" Padding="12,10"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="No categories yet - add one from the main window."
                       Style="{StaticResource MutedTextStyle}" Margin="6,14,6,4"
                       Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>

            <ItemsControl ItemsSource="{Binding Results}" Margin="0,8,0,0" MaxHeight="360">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4" AutomationProperties.Name="{Binding Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource GhostRowButtonStyle}" HorizontalAlignment="Stretch"
                                    Padding="10,9" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock Text="{Binding AppIds.Count, StringFormat={} ({0} apps)}"
                                               Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="—" Style="{StaticResource GhostIconButtonStyle}" ToolTip="Minimize"
                                        Command="{Binding DataContext.MinimizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="⏹" Style="{StaticResource GhostIconButtonStyle}" ToolTip="Close"
                                        Command="{Binding DataContext.CloseCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Enter opens the first match · Esc closes" Style="{StaticResource MutedTextStyle}"
                       FontSize="11" Margin="6,10,6,2"/>
        </StackPanel>
    </Border>
</Window>
