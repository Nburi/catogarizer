<Window x:Class="Catogarizer.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Catogarizer.App.Controls"
        Title="Catogarizer" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Border x:Name="Root" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Margin="24" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="EntryOffset" Y="-6"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Search -->
            <Grid Margin="18,14,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Switch to..." FontSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                           IsHitTestVisible="False" Margin="2,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource InkBrush}"
                         CaretBrush="{DynamicResource InkBrush}" VerticalAlignment="Center"
                         AutomationProperties.Name="Search categories"/>
                <Border Grid.Column="1" Style="{StaticResource KeycapStyle}" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Esc" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <Rectangle Height="1" Fill="{DynamicResource BorderBrush2}"/>

            <!-- Results -->
            <TextBlock Text="Nothing matches. Try the first letters of each word." Style="{StaticResource MutedTextStyle}" Margin="20,16,20,14"
                       Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
            <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}" Margin="8,8,8,4" MaxHeight="420" Focusable="False">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Focusable="False" Cursor="Hand" AutomationProperties.Name="{Binding Name}"
                                Command="{Binding DataContext.SwitchToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" MouseEnter="Row_MouseEnter">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource ControlRadius}" Padding="10,8" Margin="0,0,0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KeycapStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Visibility="{Binding KeyText, Converter={StaticResource NullToCollapsedConverter}}">
                                    <TextBlock Text="{Binding KeyText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                                <!-- One TextBlock, so a long name and "last used" trim together with an ellipsis. -->
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><Run
                                         Text="{Binding PreviousLabel, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                                </TextBlock>
                                <ItemsControl Grid.Column="3" ItemsSource="{Binding Icons}" Focusable="False" VerticalAlignment="Center" Margin="10,0,12,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <c:AppIconView ExecutablePath="{Binding ExecutablePath}" DisplayName="{Binding Name}" IconSize="18" Margin="0,0,4,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="4" Text="{Binding StateText}" FontSize="12"
                                           VerticalAlignment="Center" MinWidth="86" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMissingApp}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hints -->
            <Rectangle Height="1" Fill="{DynamicResource BorderBrush2}" Margin="0,4,0,0"/>
            <Grid Margin="18,10,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Text="&#x2191;&#x2193; select  ·  Enter switch  ·  1–9 jump  ·  hotkey twice = back"/>
                <TextBlock Grid.Column="1" Text="{Binding PinnedText}" Style="{StaticResource MutedTextStyle}" FontSize="11.5"
                           Margin="12,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding PinnedText, Converter={StaticResource NullToCollapsedConverter}}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
