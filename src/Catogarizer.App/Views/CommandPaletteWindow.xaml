<Window x:Class="Catogarizer.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Border x:Name="Root" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1" CornerRadius="14" Padding="6" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="EntryOffset" Y="-6"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="10">
            <TextBox x:Name="SearchBox" Style="{StaticResource ThemedTextBoxStyle}" FontSize="15" Padding="12,10"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Nothing matches. Try a shorter name."
                       Style="{StaticResource MutedTextStyle}" Margin="6,14,6,4"
                       Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>

            <ItemsControl ItemsSource="{Binding Results}" Margin="0,8,0,0" MaxHeight="360">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostRowButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Padding="10,9" Margin="0,0,0,4" AutomationProperties.Name="{Binding Name}"
                                Command="{Binding DataContext.SwitchToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Enter switches to the first match · Esc closes · press the hotkey twice to go back"
                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="6,10,6,2" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
