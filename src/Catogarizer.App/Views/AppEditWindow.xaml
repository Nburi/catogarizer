<Window x:Class="Catogarizer.App.Views.AppEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource InkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel>
            <Border Background="{StaticResource SurfaceBrush}" Height="36" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Border>

            <StackPanel Margin="20,20,20,16">

                <TextBlock Text="Name" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,14" />

                <TextBlock Text="Executable" Style="{StaticResource FormLabel}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ActionButtonSecondary}" Command="{Binding BrowseCommand}" />
                </Grid>

                <TextBlock Text="Arguments (optional)" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,14" />

                <TextBlock Text="Working directory (optional)" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,14" />

                <TextBlock Text="Window position &amp; size" Style="{StaticResource FormLabel}" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource FormTextBox}" Text="{Binding WindowX, UpdateSourceTrigger=PropertyChanged}" ToolTip="X" />
                    <TextBox Grid.Column="2" Style="{StaticResource FormTextBox}" Text="{Binding WindowY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y" />
                    <TextBox Grid.Column="4" Style="{StaticResource FormTextBox}" Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="Width" />
                    <TextBox Grid.Column="6" Style="{StaticResource FormTextBox}" Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Height" />
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X" Style="{StaticResource FormLabel}" Margin="0" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource FormLabel}" Margin="0" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Width" Style="{StaticResource FormLabel}" Margin="0" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="Height" Style="{StaticResource FormLabel}" Margin="0" HorizontalAlignment="Center" />
                </Grid>

                <TextBlock Text="Capture from a window that's already open" Style="{StaticResource FormLabel}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding RunningWindows}" SelectedItem="{Binding SelectedRunningWindow}"
                              DisplayMemberPath="Title" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource ActionButtonSecondary}" Command="{Binding RefreshRunningWindowsCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Capture" Style="{StaticResource ActionButtonSecondary}" Command="{Binding CaptureCommand}" />
                </Grid>

                <TextBlock Text="Launch delay before the next app in this category (ms)" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding LaunchDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" />

                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,10,0,0"
                              Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource FormError}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancel" Style="{StaticResource ActionButtonSecondary}" Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Content="Save" Style="{StaticResource ActionButtonPrimary}" Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
