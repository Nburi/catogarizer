<Window x:Class="Catogarizer.App.Views.AppEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="22">
        <TextBlock Text="{Binding HeadingText}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,16"/>

        <!-- ===== Search mode ===== -->
        <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="Search installed apps" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource ThemedTextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <Border Height="120" Margin="0,10,0,0"
                    Visibility="{Binding IsSearchingApps, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,0,0,10"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceAltBrush}" BorderThickness="0"/>
                    <TextBlock Text="Searching installed apps..." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="320" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSearchingApps, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding FilteredApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostRowButtonStyle}" HorizontalAlignment="Stretch"
                                    Padding="10,8"
                                    Command="{Binding DataContext.PickInstalledAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"/>
                                        <Border Margin="7,0,0,0" Padding="6,1" CornerRadius="6" VerticalAlignment="Center"
                                                Background="{StaticResource AccentBrush}"
                                                Visibility="{Binding IsPwa, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Web App" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource MutedTextStyle}" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Margin="0,12,0,0" Cursor="Hand" Foreground="{StaticResource AccentBrush}" FontSize="12.5">
                <Hyperlink Command="{Binding SwitchToManualCommand}" TextDecorations="None">
                    Can't find it? Browse for the .exe instead
                </Hyperlink>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90"
                        Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Manual mode ===== -->
        <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Style="{StaticResource ThemedTextBoxStyle}" Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding NameError}" Style="{StaticResource ErrorTextStyle}"
                       Visibility="{Binding NameError, Converter={StaticResource NullToCollapsedConverter}}"/>

            <TextBlock Text="{Binding PathFieldLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource ThemedTextBoxStyle}"
                         Text="{Binding ManualPath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" Command="{Binding BrowseCommand}"/>
            </Grid>
            <TextBlock Text="{Binding PathError}" Style="{StaticResource ErrorTextStyle}"
                       Visibility="{Binding PathError, Converter={StaticResource NullToCollapsedConverter}}"/>

            <TextBlock Text="Launch arguments (optional)" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5"/>
            <TextBox Style="{StaticResource ThemedTextBoxStyle}" Text="{Binding ManualArguments, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"
                    Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0"
                    Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="90"
                    Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
