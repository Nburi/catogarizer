<Window x:Class="Catogarizer.App.Views.TriggersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation" Width="560" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Automation" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ New trigger" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddTriggerCommand}"/>
        </Grid>

        <!-- Notice banner -->
        <Border Grid.Row="1" Margin="0,0,0,14" CornerRadius="10" Padding="12,10"
                Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                Visibility="{Binding Notice, Converter={StaticResource NullToCollapsedConverter}}">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource DangerColor}"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Notice}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostIconButtonStyle}"
                        Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Empty state -->
                <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding HasTriggers, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="No triggers yet" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Automate opening or closing apps at Windows start, on a schedule, or on demand."
                               Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Width="360" Margin="0,0,0,16"/>
                    <Button Content="+ New trigger" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddTriggerCommand}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Triggers}"
                              Visibility="{Binding HasTriggers, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"/>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="5"
                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ScheduleLabel}" Style="{StaticResource MutedTextStyle}" FontSize="11.5"
                                                    Visibility="{Binding ScheduleLabel, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        <TextBlock Text="{Binding ActionsSummary}" Style="{StaticResource MutedTextStyle}" FontSize="11.5"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Run now" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12"
                                                    Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                            <Button Content="Edit" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12"
                                                    Command="{Binding DataContext.EditTriggerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                            <Button Content="Delete" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12"
                                                    Command="{Binding DataContext.DeleteTriggerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Top"
                                              ToolTip="Enabled" AutomationProperties.Name="{Binding Name}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="CloseButton_Click"/>
        </StackPanel>

        <!-- Busy overlay -->
        <Border Grid.RowSpan="4" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,0,0,12"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{DynamicResource InkBrush}" FontSize="13.5"
                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
