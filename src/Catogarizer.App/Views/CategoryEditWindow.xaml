<Window x:Class="Catogarizer.App.Views.CategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New category" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="22">
        <TextBlock Text="{Binding HeadingText}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,16"/>

        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource ThemedTextBoxStyle}" MaxLength="60"
                 AutomationProperties.Name="Category name"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="For example Deep Work, Comms or Study. Next you pick the apps it opens."
                   Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0"
                    Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="{Binding SaveButtonText}" Style="{StaticResource PrimaryButtonStyle}" Width="90"
                    Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
