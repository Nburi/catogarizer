<Window x:Class="Catogarizer.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="22">
        <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    Width="90" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="Delete" Style="{StaticResource DangerButtonStyle}"
                    Width="90" Click="ConfirmButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
