<Window x:Class="Catogarizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Catogarizer.App.Converters"
        Title="Catogarizer" Height="720" Width="1080"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="Catogarizer" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Empty state: no categories yet -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasCategories, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="No categories yet" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Categories you add will show up here as cards you can open with one click."
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Populated state: category cards -->
            <ItemsControl ItemsSource="{Binding Categories}"
                          Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,14,14" Width="230">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
