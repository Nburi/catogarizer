<Window x:Class="Catogarizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Catogarizer"
        Icon="Assets/app.ico"
        Height="720" Width="1180" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Background="{StaticResource InkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon" IconSource="Assets/app.ico" ToolTipText="Catogarizer"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Catogarizer" Click="ShowWindow_Click" />
                    <Separator />
                    <MenuItem Header="Open a category" ItemsSource="{Binding Categories}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding OpenCommand}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="&#x25C6;" Foreground="{StaticResource MagentaBrush}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="C A T O G A R I Z E R" Margin="8,0,0,0" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#x2013;" Click="Minimize_Click" />
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource TitleBarButton}" Content="&#x25A1;" Click="MaximizeRestore_Click" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#x2715;" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="18,18,10,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="W O R K S P A C E S" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="&#x002B;" Style="{StaticResource RowIconButton}"
                                Command="{Binding AddCategoryCommand}" ToolTip="New category"
                                AutomationProperties.Name="New category" />
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Left" Margin="10,8" Style="{StaticResource ActionButtonSecondary}"
                                Command="{Binding ToggleSettingsCommand}" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2699;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Settings" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             ItemContainerStyle="{StaticResource CategoryListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.Name="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="&#x270E;" Style="{StaticResource RowIconButton}"
                                            Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="Rename" AutomationProperties.Name="Rename category" />
                                    <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource RowIconButton}"
                                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="Delete" AutomationProperties.Name="Delete category" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="28" Height="28" StrokeThickness="3" Stroke="{StaticResource CyanBrush}"
                             StrokeDashArray="2 1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                             HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="Loading workspaces…" Style="{StaticResource BodyMutedText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="&#x25A6;" FontSize="22" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No categories yet" Style="{StaticResource HeadingText}" HorizontalAlignment="Center" Margin="0,18,0,8" />
                    <TextBlock Style="{StaticResource BodyMutedText}" TextAlignment="Center"
                               Text="Group the apps you use together into a category, then open, close, or minimize all of them in one click." />
                </StackPanel>

                <Grid Margin="28" Visibility="{Binding ShowCategoryContent, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedCategory.Name}" Style="{StaticResource HeadingText}" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+ Add app" Style="{StaticResource ActionButtonSecondary}" Command="{Binding SelectedCategory.AddAppCommand}" Margin="0,0,16,0" />
                            <Button Content="Open" Style="{StaticResource ActionButtonPrimary}" Command="{Binding SelectedCategory.OpenCommand}" Margin="0,0,8,0" />
                            <Button Content="Minimize" Style="{StaticResource ActionButtonSecondary}" Command="{Binding SelectedCategory.MinimizeCommand}" Margin="0,0,8,0" />
                            <Button Content="Close" Style="{StaticResource ActionButtonSecondary}" Command="{Binding SelectedCategory.CloseCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource StatusBanner}"
                            Visibility="{Binding SelectedCategory.HasStatusMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedCategory.StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2">
                        <TextBlock Text="No apps in this category yet." Style="{StaticResource BodyMutedText}"
                                   Visibility="{Binding SelectedCategory.HasApps, Converter={StaticResource InverseBoolToVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedCategory.HasApps, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding SelectedCategory.Apps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AppTile}" AutomationProperties.Name="{Binding Name}"
                                                ToolTip="{Binding StatusMessage}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                                                    <MenuItem Header="Minimize" Command="{Binding MinimizeCommand}" />
                                                    <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <Grid HorizontalAlignment="Left">
                                                    <Border Style="{StaticResource AppTileIcon}">
                                                        <TextBlock Text="{Binding Initial}" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Ellipse Style="{StaticResource RunningDot}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" Margin="0,10,0,0" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           AutomationProperties.Name="{Binding Name}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="&#x270E;" Style="{StaticResource RowIconButton}"
                                                            Command="{Binding DataContext.SelectedCategory.EditAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="Edit" AutomationProperties.Name="Edit app" />
                                                    <Button Content="&#x2715;" Style="{StaticResource RowIconButton}"
                                                            Command="{Binding DataContext.SelectedCategory.DeleteAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove app" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.RowSpan="3" Background="#B30A0A10"
                            Visibility="{Binding SelectedCategory.IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Working…" Style="{StaticResource BodyMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Settings -->
                <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowSettingsContent, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource HeadingText}" FontSize="20" Margin="0,0,0,22" />

                        <StackPanel DataContext="{Binding Settings}">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Start with Windows" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Launch Catogarizer automatically when you sign in." Style="{StaticResource BodyMutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutostartEnabled}"
                                          VerticalAlignment="Center" AutomationProperties.Name="Start with Windows" />
                            </Grid>

                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Start minimized to tray" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="When Catogarizer starts with Windows, keep the window hidden until you open it from the tray." Style="{StaticResource BodyMutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimizedToTray}"
                                          VerticalAlignment="Center" AutomationProperties.Name="Start minimized to tray" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Blocked apps" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="Anything on this list gets closed automatically the moment it launches." Style="{StaticResource BodyMutedText}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FormTextBox}" Margin="0,0,8,0"
                                     Text="{Binding NewBlockedAppName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New blocked process name" />
                            <Button Grid.Column="1" Content="Block" Style="{StaticResource ActionButtonSecondary}"
                                    Command="{Binding AddBlockedAppCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding BlockedApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid AutomationProperties.Name="{Binding ProcessName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource RowIconButton}"
                                                    Command="{Binding DataContext.RemoveBlockedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Unblock" AutomationProperties.Name="Unblock" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
