<Window x:Class="Catogarizer.App.Views.SwitchPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catogarizer" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" IsHitTestVisible="False"
        FontFamily="{DynamicResource UiFont}">
    <!-- Margin leaves room for the shadow inside the transparent window. -->
    <Grid Margin="28,20,28,28">
        <Border x:Name="Pill" CornerRadius="21" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Lift" Y="14"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.24" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Border x:Name="Tint" CornerRadius="21" Opacity="0.16"/>
                <StackPanel Orientation="Horizontal" Margin="16,9,20,10">
                    <TextBlock x:Name="Arrow" Text="&#x2190;" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,-1,9,0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ArrowNudge" X="6"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Ellipse x:Name="Dot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,1,9,0"/>
                    <TextBlock x:Name="Label" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
