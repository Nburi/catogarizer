<Window x:Class="Catogarizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Catogarizer.App.Controls"
        Title="Catogarizer" Height="760" Width="1080"
        MinHeight="480" MinWidth="620"
        Icon="Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <!-- State glyphs of a parked category tile: leaf = Eco, moon = Asleep, snowflake = Frozen. -->
        <Geometry x:Key="LeafGeometry">M3,13 C3,7 7,4 13,4 C13,10 10,14 4,14 M3,13 L8,8</Geometry>
        <Geometry x:Key="MoonGeometry">M13,9.5 A5.5,5.5 0 1 1 6.5,3 A4.5,4.5 0 0 0 13,9.5 Z</Geometry>
        <Geometry x:Key="SnowGeometry">M8,1.5 L8,14.5 M2.4,4.7 L13.6,11.3 M2.4,11.3 L13.6,4.7</Geometry>
        <Geometry x:Key="ShieldGeometry">M8,1.8 L13,3.6 L13,7.7 C13,10.7 10.9,12.9 8,14.2 C5.1,12.9 3,10.7 3,7.7 L3,3.6 Z</Geometry>

        <Style x:Key="BoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- A small app label: icon + name. -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="4,3,10,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <!-- Shelf tile: the whole tile switches; its border takes the category color on hover. -->
        <Style x:Key="ShelfTileStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14,12,12,12">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Lift"/>
                            </Border.RenderTransform>
                            <ContentPresenter x:Name="Body"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- The tile falls asleep: its content dims slowly when the category is put to rest, and wakes quickly. -->
                            <DataTrigger Binding="{Binding IsResting}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Color}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsUnsorted}" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="Transparent"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,20,28,24">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="C" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Catogarizer" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Switch from anywhere" Style="{StaticResource MutedTextStyle}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0" x:Name="HotkeyHintLabel"/>
                    <ItemsControl ItemsSource="{Binding HotkeyKeys}" ItemTemplate="{StaticResource KeycapTemplate}" VerticalAlignment="Center"
                                  Margin="0,0,14,0" Focusable="False" x:Name="HotkeyHintKeys">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Content="&#x2699;" Style="{StaticResource GhostIconButtonStyle}" Width="34" Height="34" FontSize="15"
                            Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}" ToolTip="Settings"
                            AutomationProperties.Name="Settings"/>
                    <Button Content="+ Quick category" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding NewQuickCategoryCommand}"
                            ToolTip="A temporary category that disappears when its last window closes  ·  press +"
                            AutomationProperties.Name="New quick category"/>
                    <Button Content="+ New category" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NewCategoryCommand}"/>
                </StackPanel>
            </Grid>

            <!-- A newer version exists: a quiet note with a link, nothing is downloaded for you. -->
            <Border Margin="0,0,0,14" CornerRadius="{DynamicResource ControlRadius}" Padding="14,8"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    Visibility="{Binding UpdateText, Converter={StaticResource NullToCollapsedConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Download page" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="12,0,6,0"
                            VerticalAlignment="Center" Command="{Binding OpenUpdateCommand}"
                            AutomationProperties.Name="Open the download page in your browser"/>
                    <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource GhostIconButtonStyle}"
                            Command="{Binding DismissUpdateCommand}" ToolTip="Hide until next start" AutomationProperties.Name="Hide the update note"/>
                </Grid>
            </Border>

            <!-- Problems (launch failures etc.) -->
            <Border Margin="0,0,0,14" CornerRadius="{DynamicResource ControlRadius}" Padding="14,10"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding Notice, Converter={StaticResource NullToCollapsedConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Open editor" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="12,0,6,0"
                            VerticalAlignment="Center" Command="{Binding EditNoticeCategoryCommand}"
                            Visibility="{Binding NoticeCanEdit, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource GhostIconButtonStyle}"
                            Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"/>
                </Grid>
            </Border>

            <!-- First launch: explain before any term (Unsorted, parked, held back) shows up. -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CardRadius}" Padding="24,20" Margin="0,0,0,16"
                    Visibility="{Binding HasCategories, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="One keystroke between kinds of work" FontFamily="{DynamicResource HeadingFont}" FontSize="19"
                                   FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Make a category for each kind of work, like Deep Work or Comms. Switching to one parks the windows you don't need (hidden, never closed) and brings its own back exactly as you left them."/>
                        <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Until then, everything you have open is in Unsorted - that's what you see below."/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Make your first category" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                            Command="{Binding NewCategoryCommand}"/>
                </Grid>
            </Border>

            <!-- Now -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="{DynamicResource CardRadius}">
                <Grid>
                    <Border Background="{Binding HeroTint}" CornerRadius="{DynamicResource CardRadius}"/>
                    <Grid x:Name="HeroGrid" Margin="26,22,26,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="NowColumn" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="YOU'RE IN" Style="{StaticResource SectionLabelStyle}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="13" Height="13" Fill="{Binding ActiveColor}" VerticalAlignment="Center" Margin="0,4,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ActiveName}" FontFamily="{DynamicResource HeadingFont}" FontSize="34"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Style="{StaticResource KeycapStyle}" Margin="0,0,10,0" Padding="7,2" VerticalAlignment="Center"
                                            ToolTip="Temporary: it is not saved and disappears when its last window closes"
                                            Visibility="{Binding ActiveIsTemporary, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="TEMP" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                    </Border>
                                    <Button Content="Edit" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                            Command="{Binding EditActiveCommand}" AutomationProperties.Name="Edit this category"
                                            Visibility="{Binding CanEditActive, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                            Command="{Binding CloseTemporaryCommand}" ToolTip="Close this category and its windows  ·  Ctrl+W"
                                            AutomationProperties.Name="Close this quick category"
                                            Visibility="{Binding ActiveIsTemporary, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12.5" Margin="25,6,0,14">
                                <Run Text="{Binding ActiveSinceText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding WindowCountText, Mode=OneWay}"/>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding ActiveWindows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                                CornerRadius="{DynamicResource ControlRadius}" Margin="0,0,0,6">
                                            <Button Style="{StaticResource GhostRowButtonStyle}" Padding="10,7"
                                                    AutomationProperties.Name="{Binding Title}" ToolTip="Bring to front  ·  right-click to move or pin"
                                                    ContextMenuOpening="WindowRow_ContextMenuOpening"
                                                    Command="{Binding DataContext.BringToFrontCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource ThemedContextMenuStyle}">
                                                        <ContextMenu.ItemContainerStyle>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource ThemedMenuItemStyle}">
                                                                <EventSetter Event="Click" Handler="WindowMenuItem_Click"/>
                                                            </Style>
                                                        </ContextMenu.ItemContainerStyle>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <c:AppIconView ProcessId="{Binding ProcessId}" DisplayName="{Binding AppName}" IconSize="20"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AppLabel}" Style="{StaticResource MutedTextStyle}" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding MoreWindowsText}" Style="{StaticResource GhostRowButtonStyle}" Padding="6,3" HorizontalAlignment="Left"
                                    Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                                    Command="{Binding ToggleAllWindowsCommand}"
                                    Visibility="{Binding MoreWindowsText, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"
                                    Padding="14,12" Visibility="{Binding NoWindowsText, Converter={StaticResource NullToCollapsedConverter}}">
                                <TextBlock Text="{Binding NoWindowsText}" Style="{StaticResource MutedTextStyle}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SideColumn" Grid.Column="2">
                            <!-- Held back -->
                            <Border Style="{StaticResource BoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="HELD BACK WHILE YOU'RE HERE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding HeldBack}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:AppIconView ExecutablePath="{Binding IconPath}" ProcessId="{Binding IconProcessId}" DisplayName="{Binding Name}" IconSize="18" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding HeldBackEmptyText}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding HeldBackEmptyText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <TextBlock Text="{Binding LastBlockedText}" Style="{StaticResource MutedTextStyle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding LastBlockedText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Resources: what each category costs. One level deeper than the tiles (PRINCIPLES.md, value 5). -->
                            <Border Style="{StaticResource BoxStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="RESOURCES" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MemoryLoadText}" Style="{StaticResource MutedTextStyle}" FontSize="11.5"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ResourceRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8" AutomationProperties.Name="{Binding}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="58"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StateText}" Value="Asleep">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateText}" Value="Frozen">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding BytesText}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                               Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding CpuText}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                               Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,4,0,0" Style="{StaticResource ShareBarStyle}"
                                                                 Value="{Binding SharePercent, Mode=OneWay}" Foreground="{Binding Color}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ResourcesNote}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding ResourcesNote, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="{Binding ParkedBytesText}" Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center"
                                                   Visibility="{Binding ParkedBytesText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        <Button Content="Free memory now" Style="{StaticResource GhostRowButtonStyle}" Padding="6,2" HorizontalAlignment="Right"
                                                Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                                                Command="{Binding FreeMemoryNowCommand}" AutomationProperties.Name="Free memory now"
                                                ToolTip="Pages out every parked app that may be touched, whatever the memory load"
                                                Visibility="{Binding CanFreeMemory, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding FreeNowText}" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,2,0,0"
                                               Visibility="{Binding FreeNowText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Always visible -->
                            <Border Style="{StaticResource BoxStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="ALWAYS VISIBLE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                                        <Button Content="+ Pin app" Style="{StaticResource GhostRowButtonStyle}" Padding="6,2" HorizontalAlignment="Right"
                                                Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                                                Command="{Binding PinAppCommand}" AutomationProperties.Name="Pin an app"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Pinned}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipStyle}" Padding="4,2,2,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:AppIconView ExecutablePath="{Binding IconPath}" ProcessId="{Binding IconProcessId}" DisplayName="{Binding Name}" IconSize="18" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                                        <Button Content="&#x2715;" Style="{StaticResource GhostIconButtonStyle}" Width="20" Height="20" FontSize="9"
                                                                Margin="4,0,0,0" ToolTip="Unpin" AutomationProperties.Name="Unpin"
                                                                Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Pin music or chat apps to keep them on screen in every category."
                                               Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding Pinned.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Back -->
                            <Button Style="{StaticResource GhostRowButtonStyle}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                                    Command="{Binding SwitchBackCommand}" AutomationProperties.Name="{Binding BackTitle}"
                                    Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlRadius}" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#x2190;" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                                   VerticalAlignment="Center" Margin="0,-2,10,0"/>
                                        <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding BackColor}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <StackPanel Grid.Column="2" Grid.ColumnSpan="2">
                                            <TextBlock Text="{Binding BackTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding BackDetail}" Style="{StaticResource MutedTextStyle}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding BackHint}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Shelf -->
            <TextBlock Text="SWITCH TO" Style="{StaticResource SectionLabelStyle}" Margin="2,24,0,10"/>

            <TextBlock Text="Your categories show up here." Style="{StaticResource MutedTextStyle}" FontSize="12.5" Margin="2,0,0,12"
                       Visibility="{Binding HasCategories, Converter={StaticResource InverseBoolToVis}}"/>

            <ItemsControl x:Name="ShelfList" ItemsSource="{Binding Shelf}" Focusable="False" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Columns follow the window width (code-behind), so tiles fill the row instead of leaving a gap. -->
                        <UniformGrid Columns="{Binding ShelfColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ShelfTileStyle}" AutomationProperties.Name="{Binding AutomationName}"
                                Command="{Binding DataContext.SwitchToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="9" Height="9" VerticalAlignment="Top" Margin="0,6,8,0">
                                        <Ellipse Fill="{Binding Color}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResting}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Stroke="{Binding Color}" StrokeThickness="1.6" Opacity="0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResting}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" VerticalAlignment="Top"
                                               ToolTip="{Binding Name}"/>
                                    <Button Grid.Column="2" Content="&#x270E;" Style="{StaticResource GhostIconButtonStyle}" Width="24" Height="24" FontSize="11"
                                            Margin="4,-4,2,-4" ToolTip="Edit" AutomationProperties.Name="{Binding Name, StringFormat=Edit {0}}"
                                            Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                                    <Border Grid.Column="2" Style="{StaticResource KeycapStyle}" Margin="4,0,6,0" Padding="6,1" VerticalAlignment="Top"
                                            ToolTip="Temporary: disappears when its last window closes"
                                            Visibility="{Binding IsTemporary, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="TEMP" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource KeycapStyle}" VerticalAlignment="Top"
                                            Visibility="{Binding KeyText, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="{Binding KeyText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Height="24" Margin="0,12,0,12">
                                    <ItemsControl ItemsSource="{Binding Icons}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <c:AppIconView ExecutablePath="{Binding ExecutablePath}" DisplayName="{Binding Name}" IconSize="22"
                                                               Margin="0,0,5,0" ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MoreIconsText}" Style="{StaticResource MutedTextStyle}" FontSize="11.5" VerticalAlignment="Center"
                                               Visibility="{Binding MoreIconsText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>

                                <Grid>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Background="{DynamicResource SurfaceAltBrush}">
                                        <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StateText}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissingApp}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSwitching}" Value="True">
                                                            <Setter Property="Text" Value="Opening..."/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                                    ToolTip="{Binding BlockedTooltip}"
                                                    Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource ShieldGeometry}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                                                  Width="12" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding BlockedCount}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <!-- What the category costs: a state glyph (only when it was put to rest) and its memory. -->
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding LevelTooltip}"
                                                    Visibility="{Binding HasMemory, Converter={StaticResource BoolToVis}}">
                                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center"
                                                  Visibility="{Binding IsResting, Converter={StaticResource BoolToVis}}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource LeafGeometry}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LevelKind}" Value="Asleep">
                                                                <Setter Property="Data" Value="{StaticResource MoonGeometry}"/>
                                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LevelKind}" Value="Frozen">
                                                                <Setter Property="Data" Value="{StaticResource SnowGeometry}"/>
                                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <c:MemoryText Bytes="{Binding MemoryBytes}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <c:MemoryText.Style>
                                                    <Style TargetType="c:MemoryText">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LevelKind}" Value="Asleep">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LevelKind}" Value="Frozen">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </c:MemoryText.Style>
                                            </c:MemoryText>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"
                           Visibility="{Binding NextTriggerText, Converter={StaticResource NullToCollapsedConverter}}">
                    <Run Text="Next:"/> <Run Text="{Binding NextTriggerText, Mode=OneWay}"/>
                </TextBlock>
                <Button Content="Automation..." Style="{StaticResource GhostRowButtonStyle}" Padding="6,3"
                        Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                        Command="{Binding OpenAutomationCommand}"/>
                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                           Text="In this window, number keys 1–9 switch to a category and 0 to Unsorted."
                           Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
