<Application x:Class="Catogarizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Catogarizer.App"
             xmlns:conv="clr-namespace:Catogarizer.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
            <conv:PlacementStatusConverter x:Key="PlacementStatusConverter"/>
            <conv:MissingFileConverter x:Key="MissingFileConverter"/>
            <conv:EmptyAndIdleToVisibleConverter x:Key="EmptyAndIdleToVisibleConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
